# Copy to .env and fill in. Only the LLM detectors need it; everything else runs without.
# Without a key the run replays cached Gemini answers from project_b/llm_cache/.
GEMINI_API_KEY=
# Optional overrides
# The model every committed result used:
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_RPM=10
# LLM_MODE=auto        # auto | replay | live
